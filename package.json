{
  "name": "portfolioas",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "bun run check:built-security",
    "check": "astro-check && bun run check:public",
    "check:public": "bun scripts/check-public-files.mjs",
    "check:built-security": "bun scripts/check-built-security.mjs",
    "test:smoke": "bun run build && playwright test --project=chromium",
    "test:smoke:all": "bun run build && playwright test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@lucide/astro": "^1.28.0",
    "astro": "7.2.1",
    "simple-icons": "13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
