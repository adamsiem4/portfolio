---
import '../styles/global.css';
import { siteConfig } from '../config/site.js';
import MagneticHover from '../components/MagneticHover.astro';
import PageLoader from '../components/PageLoader.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  showPageLoader?: boolean;
}

const {
  title = siteConfig.seoTitle,
  description = siteConfig.seoDescription,
  canonical = siteConfig.siteUrl,
  robots = siteConfig.robots,
  showPageLoader = true,
}: Props = Astro.props;

const canonicalUrl = new URL(canonical, siteConfig.siteUrl).toString();
const socialImageUrl = new URL(siteConfig.socialImage.src, siteConfig.siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
      description,
      inLanguage: siteConfig.language,
      publisher: {
        '@type': 'Person',
        name: siteConfig.authorName,
        url: siteConfig.siteUrl,
      },
    },
    {
      '@type': 'Person',
      name: siteConfig.authorName,
      url: siteConfig.siteUrl,
      email: siteConfig.contactEmail,
      sameAs: [siteConfig.githubUrl, siteConfig.linkedinUrl],
    },
  ],
};
---

<!doctype html>
<html
  lang={siteConfig.language}
  data-theme="dark"
  data-theme-preference="system"
  data-theme-storage-key="portfolio-theme"
  data-page-loader-enabled={showPageLoader ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.seoKeywords.join(', ')} />
    <meta name="robots" content={robots} />
    <meta name="author" content={siteConfig.authorName} />
    <meta name="publisher" content={siteConfig.authorName} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={siteConfig.socialTitle} />
    <meta property="og:description" content={siteConfig.socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content={siteConfig.socialImage.type} />
    <meta property="og:image:width" content={String(siteConfig.socialImage.width)} />
    <meta property="og:image:height" content={String(siteConfig.socialImage.height)} />
    <meta property="og:image:alt" content={siteConfig.socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteConfig.socialTitle} />
    <meta name="twitter:description" content={siteConfig.socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.socialImage.alt} />

    <link rel="icon" type={siteConfig.favicon.type} href={siteConfig.favicon.src} />
    <link
      rel="apple-touch-icon"
      sizes={`${siteConfig.appleTouchIcon.width}x${siteConfig.appleTouchIcon.height}`}
      href={siteConfig.appleTouchIcon.src}
    />
    <link rel="manifest" href={siteConfig.webManifest.path} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.authorName} />
    <meta name="theme-color" content={siteConfig.themeColor} />

    <script is:inline>
      (() => {
        // Run in <head> before first paint so CSS sees the saved/system theme and,
        // on pages that opt in, the loader state before content becomes visible.
        const root = document.documentElement;
        const storageKey = root.dataset.themeStorageKey || 'portfolio-theme';
        const pageLoaderEnabled = root.dataset.pageLoaderEnabled === 'true';
        let storedTheme = null;

        try {
          const value = localStorage.getItem(storageKey);
          storedTheme = value === 'light' || value === 'dark' ? value : null;
        } catch {
          // System appearance remains available when storage is unavailable.
        }

        const systemTheme = window.matchMedia?.('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        const theme = storedTheme || systemTheme;

        root.dataset.theme = theme;
        root.dataset.themePreference = storedTheme ? 'user' : 'system';

        // Error pages render immediately: do not create loading state, timers, or
        // scroll-restoration work when the loader component is omitted.
        if (!pageLoaderEnabled) return;

        root.dataset.pageLoading = 'true';

        // Browsers may restore the previous scroll position late during a reload.
        // Repeating the reset across two paint frames wins that race without
        // changing normal back/forward navigation behavior.
        const navigationEntry = performance.getEntriesByType('navigation')[0];
        if (navigationEntry?.type === 'reload') {
          const resetScroll = () => window.scrollTo(0, 0);

          history.scrollRestoration = 'manual';
          root.style.scrollBehavior = 'auto';
          resetScroll();

          window.addEventListener('load', () => {
            resetScroll();
            requestAnimationFrame(() => {
              resetScroll();
              requestAnimationFrame(() => {
                resetScroll();
                root.style.removeProperty('scroll-behavior');
                history.scrollRestoration = 'auto';
              });
            });
          }, { once: true });
        }

        // Fail open if the loader script stalls: never leave the document inert,
        // busy, or visually covered because an animation event did not arrive.
        window.setTimeout(() => {
          if (root.dataset.pageLoading !== 'true') return;
          delete root.dataset.pageLoading;
          document.body?.removeAttribute('aria-busy');
          document.querySelectorAll('[data-page-loader-inert]').forEach((element) => {
            element.removeAttribute('inert');
            element.removeAttribute('data-page-loader-inert');
          });
          document.querySelector('[data-page-loader]')?.remove();
        }, 6000);
      })();
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#home">Skip to content</a>
    <MagneticHover />
    {showPageLoader && <PageLoader />}
    <slot />
  </body>
</html>
