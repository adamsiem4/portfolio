---
import '../styles/global.css';
import { siteConfig } from '../config/site.js';
import PointerEffects from '../components/PointerEffects.astro';
import CyberBackground from '../components/CyberBackground.astro';
import { getLocale, localeMeta, useTranslations } from '../i18n/ui.js';
import ralewayLatinUrl from '../assets/fonts/raleway-latin-wght.woff2?url';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  showBackground?: boolean;
  localeAuto?: boolean;
  titleAlternate?: string;
}

const {
  title = t('meta.title'),
  description = t('meta.description'),
  canonical = localeMeta[locale].home,
  robots = siteConfig.robots,
  showBackground = true,
  localeAuto = false,
  titleAlternate,
}: Props = Astro.props;

const alternate = locale === 'pl' ? 'en' : 'pl';
const localeRedirect = !localeAuto && locale === 'pl' && Astro.url.pathname === '/'
  ? localeMeta.en.home : undefined;

const canonicalUrl = new URL(canonical, siteConfig.siteUrl).toString();
const socialImageUrl = new URL(siteConfig.socialImage.src, siteConfig.siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
      description,
      inLanguage: localeMeta[locale].htmlLang,
      publisher: {
        '@type': 'Person',
        name: siteConfig.authorName,
        url: siteConfig.siteUrl,
      },
    },
    {
      '@type': 'Person',
      name: siteConfig.authorName,
      url: siteConfig.siteUrl,
      email: siteConfig.contactEmail[locale],
      sameAs: [siteConfig.githubUrl, siteConfig.linkedinUrl],
    },
  ],
};
---

<!doctype html>
<html
  lang={localeMeta[locale].htmlLang}
  data-locale={locale}
  data-locale-redirect={localeRedirect}
  data-locale-auto={localeAuto ? 'true' : undefined}
  data-title-alternate={titleAlternate}
  data-theme="dark"
  data-theme-preference="system"
  data-theme-storage-key="portfolio-theme"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <meta name="keywords" content={t('meta.keywords')} />
    <meta name="robots" content={robots} />
    <meta name="author" content={siteConfig.authorName} />
    <meta name="publisher" content={siteConfig.authorName} />
    <link rel="canonical" href={canonicalUrl} />
    {!localeAuto && (
      <>
        <link rel="alternate" hreflang="pl" href={new URL('/', siteConfig.siteUrl).toString()} />
        <link rel="alternate" hreflang="en" href={new URL('/en/', siteConfig.siteUrl).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL('/', siteConfig.siteUrl).toString()} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={t('meta.socialTitle')} />
    <meta property="og:description" content={t('meta.socialDescription')} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:locale:alternate" content={localeMeta[alternate].ogLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content={siteConfig.socialImage.type} />
    <meta property="og:image:width" content={String(siteConfig.socialImage.width)} />
    <meta property="og:image:height" content={String(siteConfig.socialImage.height)} />
    <meta property="og:image:alt" content={t('meta.socialImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('meta.socialTitle')} />
    <meta name="twitter:description" content={t('meta.socialDescription')} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={t('meta.socialImageAlt')} />

    <link rel="icon" type={siteConfig.favicon.type} href={siteConfig.favicon.src} />
    <link
      rel="apple-touch-icon"
      sizes={`${siteConfig.appleTouchIcon.width}x${siteConfig.appleTouchIcon.height}`}
      href={siteConfig.appleTouchIcon.src}
    />
    <link rel="manifest" href={siteConfig.webManifest.path} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.authorName} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    {/* The hero name is the LCP element; fetch its font with the HTML instead of after style resolution. */}
    <link rel="preload" href={ralewayLatinUrl} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <script is:inline>
      (() => {
        // Run in <head> before first paint so CSS sees the saved/system theme.
        const root = document.documentElement;
        // Only an explicit switcher choice persists; shared English URLs do not.
        const langKey = 'portfolio-lang';
        const params = new URLSearchParams(location.search);
        const requestedLang = params.get('lang');
        const explicitLang = requestedLang === 'pl' || requestedLang === 'en' ? requestedLang : null;
        let storedLang = null;

        try {
          if (explicitLang) localStorage.setItem(langKey, explicitLang);
          const value = localStorage.getItem(langKey);
          storedLang = value === 'pl' || value === 'en' ? value : null;
        } catch {
          // Explicit choices and device detection still work without storage.
        }

        if (requestedLang !== null) {
          params.delete('lang');
          const query = params.toString();
          history.replaceState(null, '', location.pathname + (query ? `?${query}` : '') + location.hash);
        }

        const deviceLang = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
        const preferredLang = explicitLang || storedLang || (deviceLang.startsWith('pl') ? 'pl' : 'en');

        if (root.dataset.localeAuto === 'true') {
          root.lang = preferredLang;
          root.dataset.locale = preferredLang;
          if (preferredLang === 'en' && root.dataset.titleAlternate) {
            document.title = root.dataset.titleAlternate;
          }
        } else if (root.dataset.localeRedirect && preferredLang !== root.dataset.locale) {
          location.replace(root.dataset.localeRedirect + location.search + location.hash);
          return;
        }

        const storageKey = root.dataset.themeStorageKey || 'portfolio-theme';
        let storedTheme = null;

        try {
          const value = localStorage.getItem(storageKey);
          storedTheme = value === 'light' || value === 'dark' ? value : null;
        } catch {
          // System appearance remains available when storage is unavailable.
        }

        const systemTheme = window.matchMedia?.('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        const theme = storedTheme || systemTheme;

        root.dataset.theme = theme;
        root.dataset.themePreference = storedTheme ? 'user' : 'system';
      })();
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

  </head>

  <body>
    {/* ponytail: SVG displacement = the refraction Apple's glass has and backdrop-filter alone can't do. */}
    <svg class="glass-filter" aria-hidden="true" focusable="false" width="0" height="0">
      <filter id="liquid-glass" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.006 0.009" numOctaves="2" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="2.2" result="softNoise" />
        <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="26" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a class="skip-link" href="#home">
      {localeAuto ? (
        <>
          <span data-locale-copy="pl">{t('skip')}</span>
          <span data-locale-copy="en">{useTranslations('en')('skip')}</span>
        </>
      ) : t('skip')}
    </a>
    {showBackground && <CyberBackground />}
    <PointerEffects />
    <slot />
  </body>
</html>

<style is:global>
  [data-locale-copy] {
    display: none;
  }

  html[lang='pl'] [data-locale-copy='pl'],
  html[lang='en'] [data-locale-copy='en'] {
    display: contents;
  }
</style>
