<script>
	import { initMagneticHover } from '../scripts/magnetic-hover.js';

	const initializeMagneticHover = () => initMagneticHover(document);

	// Processed Astro scripts run after the document is parsed. The page-load hook
	// keeps the same initializer ready for a future ClientRouter without coupling it
	// to any visible component.
	initializeMagneticHover();
	document.addEventListener('astro:page-load', initializeMagneticHover);
</script>
