---
import ScrambleHeading from './ScrambleHeading.astro';
---

<section class="about" id="about" aria-labelledby="about-title">
	<div class="about__inner">
		<header class="about__heading">
			<ScrambleHeading id="about-title" text="About me" />
		</header>

		<div class="about__copy">
			<p>
				<strong>Computer science graduate</strong> based in Poland, currently pursuing a
				<strong> master’s degree in cybersecurity</strong>. I build React web applications and
				have hands-on experience with security monitoring, systems administration, and
				homelab infrastructure using Wazuh, Windows Server, Microsoft Exchange, Proxmox,
				and Debian.
			</p>

			<p>
				I’m seeking an <strong>entry-level cybersecurity role or internship</strong> where I can
				apply this technical foundation, contribute to practical security work, and continue
				growing as a cybersecurity professional.
			</p>
		</div>
	</div>
</section>

<style>
	.about {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		align-items: start;
		padding: clamp(5rem, 14vw, 9rem) var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		scroll-margin-top: 5rem;
	}

	.about__inner {
		display: grid;
		width: min(100%, 72rem);
		margin-inline: auto;
		gap: clamp(2.5rem, 8vw, 5rem);
	}

	.about__copy {
		display: grid;
		max-width: 48rem;
		gap: clamp(1.5rem, 4vw, 2.25rem);
	}

	.about__copy p {
		font-size: clamp(1.2rem, 4.5vw, 1.75rem);
		line-height: 1.4;
		letter-spacing: -0.02em;
	}

	.about__copy p + p {
		color: var(--color-muted);
	}

	.about__copy strong {
		color: var(--color-text);
		font-weight: 800;
	}

	@media (min-width: 48rem) {
		.about {
			align-items: center;
		}

		.about__inner {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
			align-items: start;
		}

		.about__copy p {
			font-size: clamp(1.25rem, 2.25vw, 1.75rem);
		}
	}
</style>
