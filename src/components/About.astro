---
import ScrambleHeading from './ScrambleHeading.astro';
import { Content as AboutCopy } from '../content/about.md';
---

<section class="about" id="about" aria-labelledby="about-title">
	<div class="about__inner">
		<header class="about__heading">
			<ScrambleHeading id="about-title" text="About me" />
		</header>

		<div class="about__copy">
			<AboutCopy />
		</div>
	</div>
</section>

<style>
	.about {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		align-items: start;
		padding: clamp(5rem, 14vw, 9rem) var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		scroll-margin-top: 5rem;
	}

	.about__inner {
		display: grid;
		width: min(100%, 72rem);
		margin-inline: auto;
		gap: clamp(2.5rem, 8vw, 5rem);
	}

	.about__copy {
		display: grid;
		max-width: 48rem;
		gap: clamp(1.5rem, 4vw, 2.25rem);
	}

	.about__copy :global(p) {
		font-size: clamp(1.2rem, 4.5vw, 1.75rem);
		line-height: 1.4;
		letter-spacing: -0.02em;
	}

	.about__copy :global(p + p) {
		color: var(--color-muted);
	}

	.about__copy :global(strong) {
		color: var(--color-text);
		font-weight: 800;
	}

	@media (min-width: 48rem) {
		.about {
			align-items: center;
		}

		.about__inner {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
			align-items: start;
		}

		.about__copy :global(p) {
			font-size: clamp(1.25rem, 2.25vw, 1.75rem);
		}
	}
</style>
