---
import { siteConfig } from '../config/site.js';

const { scene, glyphs } = siteConfig.background;
---

<canvas
	class="cyber-background"
	aria-hidden="true"
	data-cyber-background
	data-scene={scene}
	data-glyphs={glyphs}
></canvas>

<script>
	import { initCyberBackground } from '../scripts/cyber-background/core.js';

	const initialize = () => {
		document.querySelectorAll<HTMLCanvasElement>('[data-cyber-background]').forEach(initCyberBackground);
	};

	initialize();
	document.addEventListener('astro:page-load', initialize);
</script>

<style>
	/* A stacking context on body lets the negative z-index canvas paint above the
	   body background but below all page content. */
	:global(body) {
		isolation: isolate;
	}

	.cyber-background {
		position: fixed;
		z-index: -1;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		/* Large viewport height stays constant while mobile browser bars collapse. */
		height: 100lvh;
		pointer-events: none;
	}

	.cyber-background[data-active] {
		--cyber-grid: color-mix(in srgb, var(--color-text) 3.5%, transparent);
		background-image:
			linear-gradient(to right, var(--cyber-grid) 1px, transparent 1px),
			linear-gradient(to bottom, var(--cyber-grid) 1px, transparent 1px);
		background-size: var(--cyber-cell) var(--cyber-cell);
	}
</style>
