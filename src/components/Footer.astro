---
import { CircleArrowUp } from '@lucide/astro';
import { siteConfig } from '../config/site.js';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<p class="site-footer__copyright">
			© <span data-current-year>{currentYear}</span> {siteConfig.name}
		</p>

		<a class="site-footer__top-link" href="#home">
			Back to top
			<CircleArrowUp size={18} stroke-width={1.8} />
		</a>
	</div>
</footer>

<script>
	document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((year) => {
		year.textContent = String(new Date().getFullYear());
	});
</script>

<style>
	.site-footer {
		padding: 0.875rem var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		background: var(--color-background);
		font-family: "Open Sans", sans-serif;
	}

	.site-footer__inner {
		display: flex;
		width: min(100%, 72rem);
		margin-inline: auto;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.site-footer__copyright {
		font-size: 0.75rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.site-footer__top-link {
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		gap: 0.35rem;
		padding: 0.45rem 0.65rem;
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		background: var(--glass-surface);
		font-size: 0.75rem;
		white-space: nowrap;
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.site-footer__top-link:hover {
		background: var(--glass-surface-hover);
		transform: translateY(-2px);
	}

	.site-footer__top-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__top-link {
			transition: none;
		}
	}
</style>
