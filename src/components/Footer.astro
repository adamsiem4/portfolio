---
import { CircleArrowUp, Info, X } from '@lucide/astro';
import { siteConfig } from '../config/site.js';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<p class="site-footer__copyright">
			© <span data-current-year>{currentYear}</span> {siteConfig.name}
		</p>

		<div class="site-footer__actions">
			<span
				class="site-footer__magnetic"
				data-magnetic
				data-magnetic-max="6"
				data-magnetic-strength="0.16"
			>
				<button
					class="site-footer__privacy-button"
					type="button"
					aria-label="Privacy and data notice"
					title="Privacy and data notice"
					aria-haspopup="dialog"
					aria-expanded="false"
					aria-controls="privacy-notice"
					data-privacy-open
					data-magnetic-target
				>
					<Info size={18} stroke-width={1.8} aria-hidden="true" />
				</button>
			</span>

			<span
				class="site-footer__magnetic"
				data-magnetic
				data-magnetic-max="6"
				data-magnetic-strength="0.16"
			>
				<a
					class="site-footer__top-link"
					href="#home"
					data-back-to-top
					data-magnetic-target
				>
					Back to top
					<CircleArrowUp size={18} stroke-width={1.8} />
				</a>
			</span>
		</div>
	</div>

	<dialog
		class="privacy-dialog"
		id="privacy-notice"
		aria-labelledby="privacy-notice-title"
		aria-describedby="privacy-notice-description"
		data-privacy-dialog
	>
		<div class="privacy-dialog__surface">
			<header class="privacy-dialog__header">
				<span class="privacy-dialog__icon" aria-hidden="true">
					<Info size={20} stroke-width={1.8} />
				</span>
				<h2 id="privacy-notice-title" tabindex="-1" data-privacy-title>
					{siteConfig.privacyNotice.title}
				</h2>
				<button
					class="privacy-dialog__close"
					type="button"
					aria-label="Close privacy notice"
					data-privacy-close
				>
					<X size={19} stroke-width={1.8} aria-hidden="true" />
				</button>
			</header>

			<div class="privacy-dialog__body" id="privacy-notice-description">
				<p>{siteConfig.privacyNotice.summary}</p>
				<p>{siteConfig.privacyNotice.preference}</p>
				<p>{siteConfig.privacyNotice.hosting}</p>
				<p>{siteConfig.privacyNotice.contact}</p>
				<a
					class="privacy-dialog__provider-link"
					href={siteConfig.privacyNotice.providerUrl}
					aria-label="Read Cloudflare Privacy Policy"
					target="_blank"
					rel="noopener noreferrer"
				>
					Cloudflare Privacy Policy
				</a>
			</div>
		</div>
	</dialog>
</footer>

<script>
	document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((year) => {
		year.textContent = String(new Date().getFullYear());
	});

	const backToTop = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
	const pageMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	backToTop?.addEventListener('click', (event) => {
		event.preventDefault();
		window.scrollTo({
			top: 0,
			left: 0,
			behavior: pageMotionPreference.matches ? 'auto' : 'smooth',
		});
	});

	const privacyTrigger = document.querySelector<HTMLButtonElement>('[data-privacy-open]');
	const privacyDialog = document.querySelector<HTMLDialogElement>('[data-privacy-dialog]');
	const privacyClose = privacyDialog?.querySelector<HTMLButtonElement>('[data-privacy-close]');
	const privacyTitle = privacyDialog?.querySelector<HTMLElement>('[data-privacy-title]');
	const privacySurface = privacyDialog?.querySelector<HTMLElement>('.privacy-dialog__surface');
	const privacyMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	type PrivacyDialogState = 'closed' | 'opening' | 'open' | 'closing';

	let privacyDialogState: PrivacyDialogState = 'closed';
	let activePrivacyAnimations: Animation[] = [];

	const clearPrivacyAnimations = () => {
		activePrivacyAnimations.forEach((animation) => animation.cancel());
		activePrivacyAnimations = [];
	};

	const waitForPrivacyAnimations = (animations: Animation[]) => Promise.all(
		animations.map(async (animation) => {
			try {
				await animation.finished;
			} catch {
				// Cancellation is expected when the dialog or motion preference changes.
			}
		}),
	);

	const getPrivacyMorphTransform = (sourceBounds?: DOMRect) => {
		if (!privacyTrigger || !privacyDialog) return null;

		const triggerBounds = sourceBounds ?? privacyTrigger.getBoundingClientRect();
		const dialogBounds = privacyDialog.getBoundingClientRect();
		if (dialogBounds.width === 0 || dialogBounds.height === 0) return null;

		const translateX = (
			triggerBounds.left + (triggerBounds.width / 2)
			- dialogBounds.left - (dialogBounds.width / 2)
		);
		const translateY = (
			triggerBounds.top + (triggerBounds.height / 2)
			- dialogBounds.top - (dialogBounds.height / 2)
		);
		const scaleX = Math.max(0.01, triggerBounds.width / dialogBounds.width);
		const scaleY = Math.max(0.01, triggerBounds.height / dialogBounds.height);

		return `translate3d(${translateX.toFixed(2)}px, ${translateY.toFixed(2)}px, 0) scale(${scaleX.toFixed(4)}, ${scaleY.toFixed(4)})`;
	};

	const canAnimatePrivacyDialog = () => (
		!privacyMotionPreference.matches
		&& document.visibilityState === 'visible'
		&& typeof privacyDialog?.animate === 'function'
	);

	const closePrivacyDialog = async () => {
		if (!privacyDialog?.open || privacyDialogState === 'closing') return;

		if (privacyDialogState === 'opening') {
			privacyDialogState = 'closing';
			const reversingAnimations = [...activePrivacyAnimations];
			reversingAnimations.forEach((animation) => animation.reverse());
			await waitForPrivacyAnimations(reversingAnimations);

			if (privacyDialogState !== 'closing') return;
			clearPrivacyAnimations();
			if (privacyDialog.open) privacyDialog.close();
			return;
		}

		privacyDialogState = 'closing';
		if (!canAnimatePrivacyDialog()) {
			privacyDialog.close();
			return;
		}

		const morphTransform = getPrivacyMorphTransform();
		if (!morphTransform) {
			privacyDialog.close();
			return;
		}

		const dialogAnimation = privacyDialog.animate(
			[
				{
					transform: 'translate3d(0, 0, 0) scale(1)',
					borderRadius: '1.5rem',
				},
				{
					transform: morphTransform,
					borderRadius: '999px',
				},
			],
			{
				duration: 360,
				easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
				fill: 'both',
			},
		);
		const surfaceAnimation = privacySurface?.animate(
			[
				{ opacity: 1, transform: 'translate3d(0, 0, 0)' },
				{ opacity: 0, transform: 'translate3d(0, 0.35rem, 0)' },
			],
			{
				duration: 150,
				easing: 'ease-in',
				fill: 'both',
			},
		);

		activePrivacyAnimations = [
			dialogAnimation,
			...(surfaceAnimation ? [surfaceAnimation] : []),
		];
		await waitForPrivacyAnimations(activePrivacyAnimations);

		if (privacyDialogState !== 'closing') return;
		clearPrivacyAnimations();
		if (privacyDialog.open) privacyDialog.close();
	};

	const openPrivacyDialog = async () => {
		if (!privacyDialog || privacyDialog.open || privacyDialogState !== 'closed') return;

		const triggerBounds = privacyTrigger?.getBoundingClientRect();
		privacyDialogState = 'opening';
		privacyTrigger?.setAttribute('aria-expanded', 'true');
		privacyDialog.showModal();
		privacyTitle?.focus({ preventScroll: true });

		if (!canAnimatePrivacyDialog()) {
			privacyDialogState = 'open';
			return;
		}

		const morphTransform = getPrivacyMorphTransform(triggerBounds);
		if (!morphTransform) {
			privacyDialogState = 'open';
			return;
		}

		const dialogAnimation = privacyDialog.animate(
			[
				{
					transform: morphTransform,
					borderRadius: '999px',
				},
				{
					transform: 'translate3d(0, 0, 0) scale(1)',
					borderRadius: '1.5rem',
				},
			],
			{
				duration: 520,
				easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
				fill: 'both',
			},
		);
		const surfaceAnimation = privacySurface?.animate(
			[
				{
					opacity: 0,
					transform: 'translate3d(0, 0.6rem, 0)',
					offset: 0,
				},
				{
					opacity: 0,
					transform: 'translate3d(0, 0.6rem, 0)',
					offset: 0.42,
				},
				{
					opacity: 1,
					transform: 'translate3d(0, 0, 0)',
					offset: 1,
				},
			],
			{
				duration: 520,
				easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
				fill: 'both',
			},
		);

		activePrivacyAnimations = [
			dialogAnimation,
			...(surfaceAnimation ? [surfaceAnimation] : []),
		];
		await waitForPrivacyAnimations(activePrivacyAnimations);

		if (privacyDialogState !== 'opening') return;
		clearPrivacyAnimations();
		privacyDialogState = 'open';
	};

	privacyTrigger?.addEventListener('click', () => void openPrivacyDialog());
	privacyClose?.addEventListener('click', () => void closePrivacyDialog());

	privacyDialog?.addEventListener('click', (event) => {
		if (event.target === privacyDialog) void closePrivacyDialog();
	});

	privacyDialog?.addEventListener('cancel', (event) => {
		event.preventDefault();
		void closePrivacyDialog();
	});

	privacyDialog?.addEventListener('close', () => {
		clearPrivacyAnimations();
		privacyDialogState = 'closed';
		privacyTrigger?.setAttribute('aria-expanded', 'false');
	});

	privacyMotionPreference.addEventListener?.('change', (event) => {
		if (!event.matches) return;

		activePrivacyAnimations.forEach((animation) => {
			try {
				animation.finish();
			} catch {
				animation.cancel();
			}
		});
	});
</script>

<style>
	.site-footer {
		padding: 0.875rem var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		background:
			linear-gradient(var(--glass-surface), var(--glass-surface)),
			var(--color-background);
		font-family: "Open Sans", sans-serif;
	}

	.site-footer__inner {
		display: flex;
		width: min(100%, 72rem);
		margin-inline: auto;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.site-footer__copyright {
		font-size: 0.75rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.site-footer__actions {
		display: flex;
		align-items: center;
		flex: 0 0 auto;
		gap: 0.4rem;
	}

	.site-footer__magnetic {
		display: inline-flex;
	}

	.site-footer__privacy-button,
	.site-footer__top-link,
	.privacy-dialog__close {
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		border: 1px solid var(--glass-border);
		background: var(--glass-surface);
		color: var(--color-text);
		transition: background-color 180ms ease;
	}

	.site-footer__privacy-button,
	.site-footer__top-link {
		transform: translate3d(0, 0, 0);
		will-change: transform;
	}

	.site-footer__privacy-button,
	.privacy-dialog__close {
		width: 2.25rem;
		height: 2.25rem;
		justify-content: center;
		padding: 0;
		border-radius: 50%;
	}

	.site-footer__top-link {
		gap: 0.35rem;
		padding: 0.45rem 0.65rem;
		border-radius: 999px;
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.site-footer__privacy-button:hover,
	.site-footer__top-link:hover,
	.privacy-dialog__close:hover {
		background: var(--glass-surface-hover);
	}

	.site-footer__privacy-button:focus-visible,
	.site-footer__top-link:focus-visible,
	.privacy-dialog__close:focus-visible,
	.privacy-dialog__provider-link:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 3px;
	}

	.privacy-dialog {
		position: fixed;
		inset-block-start: auto;
		inset-block-end: max(0.75rem, env(safe-area-inset-bottom));
		inset-inline: 0;
		width: min(calc(100% - 2rem), 32rem);
		max-width: none;
		max-height: min(80dvh, 32rem);
		margin: 0 auto;
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		background: var(--color-background);
		color: var(--color-text);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
		transform-origin: center;
	}

	.privacy-dialog::backdrop {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.privacy-dialog__surface {
		display: flex;
		max-height: min(80dvh, 32rem);
		flex-direction: column;
	}

	.privacy-dialog__header {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem clamp(1rem, 4vw, 1.5rem);
		border-block-end: 1px solid var(--glass-border);
	}

	.privacy-dialog__header h2 {
		font-size: clamp(1rem, 4vw, 1.2rem);
		line-height: 1.2;
	}

	.privacy-dialog__header h2:focus {
		outline: none;
	}

	.privacy-dialog__icon {
		display: grid;
		color: var(--color-accent-text);
		place-items: center;
	}

	.privacy-dialog__close {
		width: 2.5rem;
		height: 2.5rem;
	}

	.privacy-dialog__body {
		display: grid;
		overflow-y: auto;
		gap: 1rem;
		padding: clamp(1.25rem, 4vw, 1.75rem);
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.privacy-dialog__body p:first-child {
		color: var(--color-text);
	}

	.privacy-dialog__provider-link {
		width: fit-content;
		color: var(--color-accent-text);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__privacy-button,
		.site-footer__top-link {
			transition: none;
		}
	}
</style>
