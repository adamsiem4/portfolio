---
const links = [
	{ label: 'About', href: '#about' },
	{ label: 'Portfolio', href: '#portfolio' },
	{ label: 'Contact', href: '#contact' },
];
---

<header class="site-header" data-navbar>
	<nav class="navbar" aria-label="Primary navigation">
		<div class="nav-actions">
			<button
				class="glass-button mode-toggle"
				type="button"
				aria-label="Light mode coming soon"
				title="Light mode coming soon"
				data-theme-toggle
				disabled
			>
				<svg class="mode-toggle__icon" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="3.5"></circle>
					<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.28 5.28l1.42 1.42M17.3 17.3l1.42 1.42M18.72 5.28 17.3 6.7M6.7 17.3l-1.42 1.42"></path>
				</svg>
			</button>

			<button
				class="glass-button menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="primary-navigation"
				data-menu-toggle
			>
				<span class="sr-only">Toggle navigation</span>
				<span class="menu-toggle__icon" aria-hidden="true">
					<span class="menu-toggle__line"></span>
					<span class="menu-toggle__line"></span>
					<span class="menu-toggle__line"></span>
				</span>
			</button>
		</div>

		<ul class="nav-links" id="primary-navigation" data-navigation-menu data-open="false">
			{links.map(({ label, href }) => (
				<li><a href={href}>{label}</a></li>
			))}
		</ul>
	</nav>
</header>

<script>
	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	const menuToggle = navbar?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = navbar?.querySelector<HTMLElement>('[data-navigation-menu]');

	const setMenuState = (isOpen: boolean) => {
		menuToggle?.setAttribute('aria-expanded', String(isOpen));
		if (menu) menu.dataset.open = String(isOpen);
	};

	menuToggle?.addEventListener('click', () => {
		setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuState(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			setMenuState(false);
			menuToggle?.focus();
		}
	});
</script>

<style>
	.site-header {
		position: fixed;
		z-index: 10;
		inset-block-start: 0;
		inset-inline: 0;
		padding: 1rem var(--page-gutter);
		font-family: "Open Sans", sans-serif;
	}

	.navbar {
		position: relative;
		display: flex;
		align-items: center;
		width: min(100%, 72rem);
		margin-inline: auto;
		justify-content: flex-end;
		gap: 0.625rem;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.glass-button {
		position: relative;
		display: grid;
		width: 3.125rem;
		aspect-ratio: 1;
		place-items: center;
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background:
			radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.12), transparent 42%),
			linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015)),
			var(--glass-surface);
		color: var(--color-text);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			inset 0 -1px 0 rgba(255, 255, 255, 0.05),
			0 10px 24px var(--glass-shadow);
		backdrop-filter: blur(16px) saturate(160%);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.glass-button:hover:not(:disabled),
	.menu-toggle[aria-expanded='true'] {
		border-color: rgba(255, 255, 255, 0.35);
		background-color: var(--glass-surface-hover);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.4),
			0 12px 28px var(--glass-shadow);
		transform: translateY(-1px);
	}

	.mode-toggle:disabled {
		cursor: default;
		opacity: 1;
	}

	.mode-toggle__icon {
		width: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
	}

	.menu-toggle__icon {
		display: grid;
		width: 1.25rem;
		gap: 0.25rem;
	}

	.menu-toggle__line {
		height: 2px;
		background: currentColor;
		transition: opacity 150ms ease, transform 150ms ease;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__line:first-child {
		transform: translateY(6px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__line:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__line:last-child {
		transform: translateY(-6px) rotate(-45deg);
	}

	.nav-links {
		position: absolute;
		inset-block-start: calc(100% + 0.5rem);
		inset-inline-end: 0;
		z-index: 1;
		display: flex;
		min-width: 11rem;
		flex-direction: column;
		padding: 0.375rem;
		border: 1px solid var(--glass-border);
		border-radius: 1.25rem;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018)),
			var(--glass-surface);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			0 14px 36px var(--glass-shadow);
		backdrop-filter: blur(18px) saturate(160%);
		-webkit-backdrop-filter: blur(18px) saturate(160%);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-0.5rem) scale(0.96);
		transform-origin: top right;
		transition:
			opacity 180ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
			visibility 0s linear 180ms;
	}

	.nav-links[data-open='true'] {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0) scale(1);
		transition-delay: 0s;
	}

	.nav-links a {
		display: block;
		padding: 0.75rem 1rem;
		border-radius: 0.875rem;
		transition: color 150ms ease, background-color 150ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible {
		color: var(--color-text);
		background: var(--glass-surface-hover);
	}

	.glass-button:focus-visible,
	.nav-links a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 48rem) {
		.site-header {
			padding-block: 1.5rem;
		}

		.menu-toggle {
			display: none;
		}

		.nav-links {
			position: static;
			display: flex;
			min-width: 0;
			flex-direction: row;
			gap: 0.125rem;
			border-radius: 999px;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
			transition: none;
		}

		.nav-links a {
			padding: 0.625rem 0.9rem;
			border-radius: 999px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-links,
		.menu-toggle__line {
			transition: none;
		}
	}
</style>
