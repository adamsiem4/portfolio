---
import { Menu, Moon, Sun, X } from '@lucide/astro';

const sectionPrefix = Astro.url.pathname === '/' ? '' : '/';
const links = [
	{ label: 'About', href: `${sectionPrefix}#about` },
	{ label: 'Projects', href: `${sectionPrefix}#projects` },
	{ label: 'Certs', href: `${sectionPrefix}#certs` },
	{ label: 'Contact', href: `${sectionPrefix}#contact` },
];
---

<header class="site-header" data-navbar>
	<nav class="navbar" aria-label="Primary navigation">
		<div class="nav-actions">
			<span class="nav-magnetic" data-magnetic data-magnetic-max="8">
				<button
					class="glass-button mode-toggle"
					type="button"
					aria-label="Switch to light mode"
					title="Switch to light mode"
					data-theme-toggle
					data-magnetic-target
				>
					<span class="mode-toggle__icon" aria-hidden="true">
						<span class="mode-toggle__glyph mode-toggle__glyph--sun">
							<Sun size={20} stroke-width={1.7} />
						</span>
						<span class="mode-toggle__glyph mode-toggle__glyph--moon">
							<Moon size={20} stroke-width={1.7} />
						</span>
					</span>
				</button>
			</span>

			<span
				class="nav-magnetic nav-magnetic--menu"
				data-magnetic
				data-magnetic-max="8"
				data-magnetic-query="(max-width: 47.999rem)"
			>
				<button
					class="glass-button menu-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="primary-navigation"
					data-menu-toggle
					data-magnetic-target
				>
					<span class="sr-only">Toggle navigation</span>
					<span class="menu-toggle__icon" aria-hidden="true">
						<span class="menu-toggle__glyph menu-toggle__glyph--menu">
							<Menu size={20} stroke-width={1.8} />
						</span>
						<span class="menu-toggle__glyph menu-toggle__glyph--close">
							<X size={20} stroke-width={1.8} />
						</span>
					</span>
				</button>
			</span>
		</div>

		<div
			class="nav-pill-magnetic"
			data-magnetic
			data-magnetic-max="5"
			data-magnetic-strength="0.12"
			data-magnetic-query="(min-width: 48rem)"
		>
			<ul
				class="nav-links"
				id="primary-navigation"
				data-navigation-menu
				data-open="false"
				data-magnetic-target
			>
				{links.map(({ label, href }) => (
					<li><a href={href} aria-label={label}>{label}</a></li>
				))}
			</ul>
		</div>
	</nav>
</header>

<script>
	const navbar = document.querySelector<HTMLElement>('[data-navbar]');

	const root = document.documentElement;
	const themeToggle = navbar?.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const menuToggle = navbar?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = navbar?.querySelector<HTMLElement>('[data-navigation-menu]');
	const themeStorageKey = root.dataset.themeStorageKey || 'portfolio-theme';
	const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
	const colorPreference = window.matchMedia('(prefers-color-scheme: light)');

	type Theme = 'dark' | 'light';
	type ThemeViewTransition = {
		ready: Promise<void>;
		finished: Promise<void>;
		skipTransition: () => void;
	};
	type ThemeDocument = Document & {
		startViewTransition?: (update: () => void) => ThemeViewTransition;
	};

	const themeDocument = document as ThemeDocument;
	// External preference changes can arrive mid-transition. Keep only the latest
	// requested theme and reconcile it after the active animation is cleaned up.
	let themeTransitionRunning = false;
	let queuedTheme: Theme | null = null;
	let activeThemeAnimation: Animation | null = null;
	let activeViewTransition: ThemeViewTransition | null = null;
	let activeThemeCover: HTMLSpanElement | null = null;
	let followsSystem = root.dataset.themePreference !== 'user';

	const getTheme = (): Theme => root.dataset.theme === 'light' ? 'light' : 'dark';
	const getSystemTheme = (): Theme => colorPreference.matches ? 'light' : 'dark';
	const parseStoredTheme = (value: string | null): Theme | null =>
		value === 'light' || value === 'dark' ? value : null;

	const updateThemeControl = (theme: Theme) => {
		const nextTheme = theme === 'dark' ? 'light' : 'dark';
		const label = `Switch to ${nextTheme} mode`;
		themeToggle?.setAttribute('aria-label', label);
		themeToggle?.setAttribute('title', label);
	};

	const setTheme = (theme: Theme, persist = true) => {
		root.dataset.theme = theme;
		updateThemeControl(theme);

		if (persist) {
			followsSystem = false;
			root.dataset.themePreference = 'user';

			try {
				localStorage.setItem(themeStorageKey, theme);
			} catch {
				// Theme switching still works when storage is unavailable.
			}
		}

		document.dispatchEvent(new CustomEvent('site-theme-change', { detail: { theme } }));
	};

	const animateThemeChange = async (theme: Theme) => {
		if (theme === getTheme() || themeTransitionRunning) return;

		if (
			!themeToggle ||
			motionPreference.matches ||
			document.visibilityState !== 'visible'
		) {
			setTheme(theme);
			return;
		}

		themeTransitionRunning = true;
		themeToggle.setAttribute('aria-busy', 'true');
		root.dataset.themeTransition = 'true';
		let themeApplied = false;
		const bounds = themeToggle.getBoundingClientRect();
		const originX = bounds.left + bounds.width / 2;
		const originY = bounds.top + bounds.height / 2;
		// The farthest-corner distance guarantees the circular wave covers the entire
		// viewport regardless of where the toggle sits.
		const radius = Math.ceil(Math.hypot(
			Math.max(originX, window.innerWidth - originX),
			Math.max(originY, window.innerHeight - originY),
		)) + 1;
		root.style.setProperty('--theme-wave-x', `${originX}px`);
		root.style.setProperty('--theme-wave-y', `${originY}px`);
		root.style.setProperty('--theme-wave-radius', `${radius}px`);

		// Use the browser's snapshot-based transition when available. The overlay path
		// reproduces the same circular reveal with the Web Animations API elsewhere.
		try {
			if (themeDocument.startViewTransition) {
				const transition = themeDocument.startViewTransition(() => {
					setTheme(theme);
					themeApplied = true;
				});
				activeViewTransition = transition;

				await transition.ready;
				await transition.finished;
			} else {
				const cover = document.createElement('span');
				cover.className = 'theme-transition-cover';
				cover.dataset.theme = theme;
				cover.setAttribute('aria-hidden', 'true');
				document.body.append(cover);
				activeThemeCover = cover;

				const coverPage = cover.animate(
					{
						clipPath: [
							`circle(0 at ${originX}px ${originY}px)`,
							`circle(${radius}px at ${originX}px ${originY}px)`,
						],
					},
					{
						duration: 500,
						easing: 'cubic-bezier(0.76, 0, 0.24, 1)',
						fill: 'forwards',
					},
				);
				activeThemeAnimation = coverPage;
				await coverPage.finished;

				cover.style.clipPath = `circle(${radius}px at ${originX}px ${originY}px)`;
				coverPage.cancel();
				activeThemeAnimation = null;
				setTheme(theme);
				themeApplied = true;
				// Let the newly themed page paint behind the opaque cover before fading it.
				await new Promise<void>((resolve) => {
					requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
				});

				const revealPage = cover.animate(
					{ opacity: [1, 0] },
					{
						duration: 150,
						easing: 'cubic-bezier(0, 0, 0.2, 1)',
						fill: 'forwards',
					},
				);
				activeThemeAnimation = revealPage;
				await revealPage.finished;
			}
		} catch {
			activeViewTransition?.skipTransition();
			if (!themeApplied) setTheme(theme);
		} finally {
			try {
				await activeViewTransition?.finished;
			} catch {
				// Cleanup still runs if the browser aborts the visual transition.
			}
			activeThemeAnimation?.cancel();
			activeThemeAnimation = null;
			activeViewTransition = null;
			activeThemeCover?.remove();
			activeThemeCover = null;
			root.style.removeProperty('--theme-wave-x');
			root.style.removeProperty('--theme-wave-y');
			root.style.removeProperty('--theme-wave-radius');
			delete root.dataset.themeTransition;
			themeToggle.removeAttribute('aria-busy');
			themeTransitionRunning = false;

			// Apply a storage/system update received during the animation only after all
			// transition artifacts have been removed.
			const externalTheme = queuedTheme;
			queuedTheme = null;
			if (externalTheme && externalTheme !== getTheme()) {
				setTheme(externalTheme, false);
			}
		}
	};

	const setMenuState = (isOpen: boolean) => {
		menuToggle?.setAttribute('aria-expanded', String(isOpen));
		if (menu) menu.dataset.open = String(isOpen);
	};

	menuToggle?.addEventListener('click', () => {
		setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
	});

	document.addEventListener('pointerdown', (event) => {
		if (
			menuToggle?.getAttribute('aria-expanded') === 'true'
			&& navbar
			&& event.target instanceof Node
			&& !navbar.contains(event.target)
		) {
			setMenuState(false);
		}
	});

	updateThemeControl(getTheme());

	themeToggle?.addEventListener('click', () => {
		if (themeTransitionRunning) return;
		followsSystem = false;
		root.dataset.themePreference = 'user';
		queuedTheme = null;
		void animateThemeChange(getTheme() === 'dark' ? 'light' : 'dark');
	});

	window.addEventListener('storage', (event) => {
		if (event.key !== themeStorageKey && event.key !== null) return;

		const storedTheme = parseStoredTheme(event.newValue);
		followsSystem = storedTheme === null;
		root.dataset.themePreference = followsSystem ? 'system' : 'user';
		const nextTheme = storedTheme ?? getSystemTheme();

		if (themeTransitionRunning) {
			queuedTheme = nextTheme;
			return;
		}
		if (nextTheme !== getTheme()) setTheme(nextTheme, false);
	});

	colorPreference.addEventListener?.('change', (event) => {
		if (!followsSystem) return;

		const nextTheme: Theme = event.matches ? 'light' : 'dark';
		if (themeTransitionRunning) {
			queuedTheme = nextTheme;
			return;
		}
		if (nextTheme !== getTheme()) setTheme(nextTheme, false);
	});

	motionPreference.addEventListener?.('change', (event) => {
		if (event.matches && themeTransitionRunning) {
			activeThemeAnimation?.cancel();
			activeViewTransition?.skipTransition();
		}
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuState(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
			setMenuState(false);
			menuToggle?.focus();
		}
	});
</script>

<style>
	.site-header {
		position: fixed;
		z-index: 10;
		inset-block-start: 0;
		inset-inline: 0;
		padding: 1rem var(--page-gutter);
		font-family: "Open Sans", sans-serif;
	}

	.navbar {
		position: relative;
		display: flex;
		align-items: center;
		width: min(100%, 72rem);
		margin-inline: auto;
		justify-content: flex-end;
		gap: 0.625rem;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.nav-magnetic {
		display: inline-flex;
	}

	.nav-pill-magnetic {
		display: contents;
	}

	.glass-button {
		position: relative;
		display: grid;
		width: 3.125rem;
		aspect-ratio: 1;
		place-items: center;
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background:
			radial-gradient(circle at 30% 20%, var(--glass-glow), transparent 42%),
			linear-gradient(145deg, var(--glass-gradient-start), var(--glass-button-gradient-end)),
			var(--glass-surface);
		color: var(--color-text);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			inset 0 -1px 0 var(--glass-inset-bottom),
			0 10px 24px var(--glass-shadow);
		backdrop-filter: blur(16px) saturate(160%);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
		transform: translate3d(0, 0, 0);
		will-change: transform;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease,
			color 180ms ease;
	}

	.nav-magnetic:hover .glass-button:not(:disabled),
	.menu-toggle[aria-expanded='true'] {
		border-color: var(--glass-border-hover);
		background-color: var(--glass-surface-hover);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight-hover),
			0 12px 28px var(--glass-shadow);
	}

	.mode-toggle__icon {
		position: relative;
		display: block;
		width: 1.25rem;
		height: 1.25rem;
	}

	.mode-toggle__glyph {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		transition:
			opacity 160ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.mode-toggle__glyph--moon {
		opacity: 0;
		transform: rotate(-45deg) scale(0.75);
	}

	:global(html[data-theme='light']) .mode-toggle__glyph--sun {
		opacity: 0;
		transform: rotate(45deg) scale(0.75);
	}

	:global(html[data-theme='light']) .mode-toggle__glyph--moon {
		opacity: 1;
		transform: rotate(0) scale(1);
	}

	.menu-toggle__icon {
		position: relative;
		display: block;
		width: 1.25rem;
		height: 1.25rem;
	}

	.menu-toggle__glyph {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		transition:
			opacity 160ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.menu-toggle__glyph--close {
		opacity: 0;
		transform: rotate(-45deg) scale(0.75);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__glyph--menu {
		opacity: 0;
		transform: rotate(45deg) scale(0.75);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__glyph--close {
		opacity: 1;
		transform: rotate(0) scale(1);
	}

	.nav-links {
		position: absolute;
		inset-block-start: calc(100% + 0.5rem);
		inset-inline-end: 0;
		z-index: 1;
		display: flex;
		min-width: 11rem;
		flex-direction: column;
		padding: 0.375rem;
		border: 1px solid var(--glass-border);
		border-radius: 1.25rem;
		background:
			linear-gradient(145deg, var(--glass-gradient-start), var(--glass-menu-gradient-end)),
			var(--glass-surface);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			0 14px 36px var(--glass-shadow);
		backdrop-filter: blur(18px) saturate(160%);
		-webkit-backdrop-filter: blur(18px) saturate(160%);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-0.5rem) scale(0.96);
		transform-origin: top right;
		transition:
			opacity 180ms ease,
			transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
			visibility 0s linear 180ms;
	}

	.nav-links[data-open='true'] {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0) scale(1);
		transition-delay: 0s;
	}

	.nav-links a {
		display: block;
		padding: 0.75rem 1rem;
		border-radius: 0.875rem;
		transition: color 150ms ease, background-color 150ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible {
		color: var(--color-text);
		background: var(--glass-surface-hover);
	}

	.glass-button:focus-visible,
	.nav-links a:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 3px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 48rem) {
		.site-header {
			padding-block: 1.5rem;
		}

		.nav-magnetic--menu,
		.menu-toggle {
			display: none;
		}

		.nav-pill-magnetic {
			display: inline-flex;
		}

		.nav-links {
			position: static;
			display: flex;
			height: 3.125rem;
			min-width: 0;
			align-items: center;
			flex-direction: row;
			gap: 0.125rem;
			border-radius: 999px;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
			transition: none;
		}

		.nav-links a {
			padding: 0.5rem 0.9rem;
			border-radius: 999px;
			line-height: 1.25;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-links,
		.mode-toggle__glyph,
		.menu-toggle__glyph {
			transition: none;
		}
	}
</style>
