---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { projects } from '../config/projects.js';
import { getProjectDeckReserve } from '../utils/project-layout.js';
import ProjectCard from './ProjectCard.astro';
import ScrambleHeading from './ScrambleHeading.astro';

const projectCount = projects.length;
const deckReserve = getProjectDeckReserve(projectCount);
const formatPosition = (position: number) => String(position).padStart(2, '0');
const getInitialSlideStyle = (index: number) => {
	const distance = index === 0 ? 0 : 12 + ((index - 1) * 10);
	const angle = index === 0 ? 0 : Math.min(0.7 + (index * 0.2), 1.5);
	const layer = index === 0 ? projectCount + 1 : projectCount - index;

	return `--card-x: ${distance}px; --card-angle: ${angle}deg; --card-layer: ${layer}; --project-index: ${index};`;
};
---

<section class="projects" id="projects" aria-labelledby="projects-title">
	<div class="projects__inner">
		<header class="projects__heading">
			<ScrambleHeading id="projects-title" text="Projects" />
		</header>

		<div
			class="projects__deck"
			data-project-deck
			data-active-index="0"
			data-project-count={projectCount}
			data-deck-reserve={deckReserve}
			role="region"
			aria-roledescription="carousel"
			aria-label="Featured projects"
			tabindex="0"
			style={`--project-count: ${projectCount}; --deck-reserve: ${deckReserve}px;`}
		>
			<ol class="projects__stack">
				{projects.map((project, index) => (
					<li
						class="projects__slide"
						data-project-slide
						data-project-title={project.title}
						data-active={index === 0 ? 'true' : 'false'}
						aria-current={index === 0 ? 'true' : undefined}
						aria-roledescription="slide"
						aria-label={`${index + 1} of ${projectCount}: ${project.title}`}
						style={getInitialSlideStyle(index)}
					>
						<div
							class="projects__card-shell"
							data-project-content
							inert={index !== 0}
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							<ProjectCard {...project} projectCount={projectCount} />
						</div>

						<button
							class="projects__activate"
							type="button"
							data-project-activate
							data-project-index={index}
							aria-label={`Show ${project.title}`}
							aria-hidden={index === 0 ? 'true' : 'false'}
							tabindex={index === 0 ? -1 : 0}
						></button>
					</li>
				))}
			</ol>

			{projectCount > 1 && (
				<div class="projects__controls" role="group" aria-label="Project navigation">
					<span
						class="projects__control-magnetic"
						data-magnetic
						data-magnetic-max="6"
						data-magnetic-strength="0.16"
					>
						<button
							class="projects__control"
							type="button"
							data-project-previous
							data-magnetic-target
							aria-label="Show previous project"
							disabled
						>
							<ChevronLeft size={20} stroke-width={1.7} aria-hidden="true" />
						</button>
					</span>

					<span class="projects__position" data-project-position>
						{formatPosition(1)} / {formatPosition(projectCount)}
					</span>

					<span
						class="projects__control-magnetic"
						data-magnetic
						data-magnetic-max="6"
						data-magnetic-strength="0.16"
					>
						<button
							class="projects__control"
							type="button"
							data-project-next
							data-magnetic-target
							aria-label="Show next project"
						>
							<ChevronRight size={20} stroke-width={1.7} aria-hidden="true" />
						</button>
					</span>
				</div>
			)}

			<p class="projects__sr-only" data-project-status aria-live="polite">
				Showing project 1 of {projectCount}: {projects[0]?.title}
			</p>
			<p class="projects__sr-only">
				Use the left and right arrow keys, navigation buttons, or a horizontal swipe to change projects.
			</p>
		</div>
	</div>
</section>

<script>
	import '../scripts/project-deck.js';
	import '../scripts/project-gallery.js';
</script>

<style>
	.projects {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		align-items: start;
		overflow: clip;
		padding: clamp(5rem, 8vw, 6rem) var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		scroll-margin-top: 5rem;
	}

	.projects__inner {
		width: min(100%, 72rem);
		margin-inline: auto;
	}

	.projects__heading {
		padding-block-end: clamp(1.5rem, 4vw, 2.5rem);
	}

	.projects__deck {
		--deck-drag-x: 0px;
		--deck-reserve: 2rem;
		position: relative;
		touch-action: pan-y;
		user-select: none;
		cursor: grab;
	}

	.projects__deck[data-dragging='true'] {
		cursor: grabbing;
	}

	.projects__deck[data-dragging='true'] .projects__slide[data-active='true'] {
		transition: none;
	}

	.projects__deck:focus-visible {
		outline: 0;
	}

	.projects__stack {
		display: grid;
		padding-block: clamp(0.75rem, 2vw, 1.25rem);
		isolation: isolate;
	}

	.projects__slide {
		position: relative;
		grid-area: 1 / 1;
		width: calc(100% - var(--deck-reserve));
		height: 100%;
		justify-self: center;
		z-index: var(--card-layer, 1);
		opacity: 0.62;
		filter: saturate(0.75) brightness(0.78);
		transform: translate3d(var(--card-x, 0px), 0, 0) rotate(var(--card-angle, 0deg));
		transform-origin: center bottom;
		transition:
			transform 560ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 360ms ease,
			filter 360ms ease;
		will-change: transform;
	}

	.projects__slide[data-active='true'] {
		opacity: 1;
		filter: none;
		transform: translate3d(calc(var(--card-x, 0px) + var(--deck-drag-x)), 0, 0)
			rotate(var(--card-angle, 0deg));
	}

	.projects__deck:focus-visible .projects__slide[data-active='true'] {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 0.35rem;
		border-radius: 1.5rem;
	}

	.projects__card-shell {
		height: 100%;
	}

	.projects__activate {
		position: absolute;
		z-index: 4;
		inset: 0;
		border: 0;
		border-radius: 1.5rem;
		background: transparent;
	}

	.projects__slide[data-active='true'] .projects__activate {
		pointer-events: none;
	}

	.projects__activate:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 0.35rem;
	}

	.projects__controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-block-start: 0.75rem;
	}

	.projects__control {
		display: grid;
		width: 2.75rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-surface);
		color: var(--color-text);
		transition: border-color 180ms ease, opacity 180ms ease;
	}

	.projects__control-magnetic {
		display: inline-flex;
		border-radius: 50%;
	}

	.projects__control:hover:not(:disabled),
	.projects__control:focus-visible {
		border-color: var(--glass-border-hover);
	}

	.projects__control:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 3px;
	}

	.projects__control:disabled {
		cursor: default;
		opacity: 0.28;
	}

	.projects__position {
		min-width: 4.5rem;
		color: var(--color-muted);
		font-family: monospace;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-align: center;
	}

	.projects__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 48rem) {
		.projects {
			align-items: center;
		}

		.projects__controls {
			margin-block-start: 1rem;
		}
	}

	@media (min-width: 75rem) {
		.projects__slide,
		.projects__card-shell {
			height: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.projects__slide,
		.projects__control {
			transition: none;
		}
	}
</style>
