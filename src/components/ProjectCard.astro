---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { siGithub, siGitlab } from 'simple-icons';

interface ProjectImage {
	src: ImageMetadata;
	alt: string;
}

interface ProjectSource {
	provider?: string;
	url: string;
	private?: boolean;
}

interface Props {
	slug?: string;
	title: string;
	eyebrow?: string;
	description: string;
	liveUrl?: string;
	source?: ProjectSource;
	images?: ProjectImage[];
	technologies?: string[];
}

const {
	title,
	eyebrow = 'Project',
	description,
	liveUrl,
	source: sourceConfig,
	images = [],
	technologies = [],
}: Props = Astro.props;

const source = sourceConfig?.provider === 'gitlab'
	? { icon: siGitlab, name: 'GitLab' }
	: { icon: siGithub, name: 'GitHub' };
const visibleImages = images.slice(0, 3);
const additionalImageCount = Math.max(0, images.length - visibleImages.length);
---

<article class="project-card">
	{liveUrl && (
		<a
			class="project-card__primary-link"
			href={liveUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={`Open ${title} live website in a new tab`}
		>
			<span class="project-card__sr-only">View live project</span>
		</a>
	)}

	{visibleImages.length > 0 && (
		<div class="project-card__media" data-image-count={visibleImages.length}>
			{visibleImages.map((image) => (
				<div class="project-card__image-frame">
					<Image
						class="project-card__image"
						src={image.src}
						alt={image.alt}
						layout="full-width"
						quality="high"
					/>
				</div>
			))}

			{additionalImageCount > 0 && (
				<span
					class="project-card__image-count"
					aria-label={`${additionalImageCount} additional project images`}
				>
					+{additionalImageCount}
				</span>
			)}
		</div>
	)}

	<div class="project-card__details">
		<div class="project-card__copy">
			<p class="project-card__label">{eyebrow}</p>
			<h3>{title}</h3>
			<p class="project-card__description">{description}</p>

			{technologies.length > 0 && (
				<ul class="project-card__stack" aria-label={`${title} technology stack`}>
					{technologies.map((technology) => <li>{technology}</li>)}
				</ul>
			)}
		</div>

		<div class="project-card__actions">
			{sourceConfig?.url && (sourceConfig.private ? (
				<span
					class="project-card__source project-card__source--disabled"
					role="link"
					aria-disabled="true"
					aria-label={`Private ${source.name} source repository`}
					title={`Private ${source.name} repository`}
				>
					<svg
						class="project-card__source-icon"
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<path d={source.icon.path} />
					</svg>
				</span>
			) : (
				<a
					class="project-card__source"
					href={sourceConfig.url}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Open ${source.name} source repository in a new tab`}
					title={`${source.name} repository`}
				>
					<svg
						class="project-card__source-icon"
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<path d={source.icon.path} />
					</svg>
				</a>
			))}

			{liveUrl && (
				<a
					class="project-card__action"
					href={liveUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Open ${title} live website in a new tab`}
					title="Open live website"
				>
					<ArrowUpRight size={24} stroke-width={1.6} />
				</a>
			)}
		</div>
	</div>
</article>

<style>
	.project-card {
		position: relative;
		display: block;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		background:
			linear-gradient(var(--glass-surface), var(--glass-surface)),
			var(--color-background);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}

	.project-card:focus-within {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	.project-card__primary-link {
		position: absolute;
		z-index: 1;
		inset: 0;
		border-radius: inherit;
	}

	.project-card__primary-link:focus-visible {
		outline: 0;
	}

	.project-card__media {
		position: relative;
		display: grid;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-block-end: 1px solid var(--glass-border);
		background: var(--glass-surface);
	}

	.project-card__media[data-image-count='2'],
	.project-card__media[data-image-count='3'] {
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: 2px;
	}

	.project-card__media[data-image-count='3'] {
		grid-template-rows: repeat(2, minmax(0, 1fr));
	}

	.project-card__media[data-image-count='3'] .project-card__image-frame:first-child {
		grid-row: 1 / -1;
	}

	.project-card__image-frame {
		min-width: 0;
		min-height: 0;
		overflow: hidden;
	}

	.project-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-card__image-count {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		min-width: 2rem;
		min-height: 2rem;
		padding: 0.35rem;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		background: rgba(9, 11, 12, 0.72);
		color: #ffffff;
		font-size: 0.7rem;
		font-weight: 700;
		backdrop-filter: blur(0.5rem);
	}

	.project-card__details {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		flex-direction: column;
		gap: 1.5rem;
		padding: clamp(1.25rem, 4vw, 2rem);
	}

	.project-card__copy {
		display: grid;
		gap: 0.4rem;
	}

	.project-card__label {
		color: var(--color-accent);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h3 {
		font-size: clamp(2rem, 8vw, 3.5rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.045em;
	}

	.project-card__description {
		max-width: 32ch;
		color: var(--color-muted);
		font-size: clamp(0.9rem, 3vw, 1.05rem);
		line-height: 1.45;
	}

	.project-card__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-block-start: 0.65rem;
	}

	.project-card__stack li {
		padding: 0.32rem 0.55rem;
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1;
	}

	.project-card__actions {
		position: relative;
		display: flex;
		align-self: flex-end;
		gap: 0.6rem;
	}

	.project-card__source,
	.project-card__action {
		display: grid;
		width: 3.25rem;
		aspect-ratio: 1;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-surface);
	}

	.project-card__source {
		position: relative;
		z-index: 2;
		color: var(--color-text);
	}

	.project-card__action {
		position: relative;
		z-index: 2;
	}

	a.project-card__source:hover,
	a.project-card__source:focus-visible,
	a.project-card__action:hover,
	a.project-card__action:focus-visible {
		border-color: var(--glass-border-hover);
	}

	a.project-card__source:focus-visible,
	a.project-card__action:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.project-card__source--disabled {
		color: var(--color-muted);
		cursor: not-allowed;
		opacity: 0.45;
	}

	.project-card__source-icon {
		width: 1.35rem;
		height: 1.35rem;
		fill: currentColor;
	}

	@media (min-width: 48rem) {
		.project-card {
			display: grid;
			grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 0.7fr);
		}

		.project-card__media {
			border-block-end: 0;
			border-inline-end: 1px solid var(--glass-border);
		}

		.project-card__details {
			height: 100%;
		}
	}

	.project-card__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
