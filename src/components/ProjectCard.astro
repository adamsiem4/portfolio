---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ArrowUpRight, ChevronDown, ChevronUp } from '@lucide/astro';
import {
	siAdguard,
	siDebian,
	siDocker,
	siExpress,
	siFirebase,
	siGithub,
	siGitlab,
	siJavascript,
	siLinux,
	siMongodb,
	siNodedotjs,
	siProxmox,
	siPython,
	siRaspberrypi,
	siReact,
	siTailwindcss,
	siUptimekuma,
} from 'simple-icons';

interface ProjectImage {
	src: ImageMetadata;
	alt: string;
}

interface ProjectSource {
	provider?: string;
	url: string;
	private?: boolean;
}

interface Props {
	slug?: string;
	title: string;
	eyebrow?: string;
	description: string;
	liveUrl?: string;
	source?: ProjectSource;
	images?: ProjectImage[];
	technologies?: string[];
}

const {
	slug,
	title,
	eyebrow = 'Project',
	description,
	liveUrl,
	source: sourceConfig,
	images = [],
	technologies = [],
}: Props = Astro.props;

const source = sourceConfig?.provider === 'gitlab'
	? { icon: siGitlab, name: 'GitLab' }
	: { icon: siGithub, name: 'GitHub' };
const technologyIcons = new Map([
	['MongoDB', siMongodb],
	['Express.js', siExpress],
	['React', siReact],
	['JavaScript', siJavascript],
	['Linux', siLinux],
	['Node.js', siNodedotjs],
	['Python', siPython],
	['Raspberry Pi', siRaspberrypi],
	['Firebase', siFirebase],
	['Proxmox', siProxmox],
	['Debian', siDebian],
	['Docker', siDocker],
	['AdGuard Home', siAdguard],
	['Uptime Kuma', siUptimekuma],
	['GitHub', siGithub],
	['GitLab', siGitlab],
	['Tailwind CSS', siTailwindcss]
]);
const imageCount = images.length;
const galleryId = slug ? `project-gallery-${slug}` : undefined;
const galleryStatusId = slug ? `project-gallery-status-${slug}` : undefined;
const hasActions = Boolean(sourceConfig?.url || liveUrl);
const projectImageWidths = [240, 320, 400, 480, 560, 640, 750, 828, 1080, 1280, 1668];
const formatImageSize = (value: number) => Number(value.toFixed(4));
const getProjectImageSizes = ({ width, height }: ImageMetadata) => {
	const containScale = Math.min(1, (width * 9) / (height * 16));
	const viewportShare = formatImageSize(containScale * 100);
	const desktopWidth = formatImageSize(containScale * 768);
	const tabletOffset = formatImageSize(containScale * 132);
	const mobileOffset = formatImageSize(containScale * 108);

	return `(min-width: 75rem) ${desktopWidth}px, (min-width: 48rem) calc(${viewportShare}vw - ${tabletOffset}px), calc(${viewportShare}vw - ${mobileOffset}px)`;
};
---

<article class="project-card">
	{liveUrl && (
		<a
			class="project-card__primary-link"
			href={liveUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={`Open ${title} live website in a new tab`}
		>
			<span class="project-card__sr-only">View live project</span>
		</a>
	)}

	{imageCount > 0 && (
		<div class="project-card__media-shell">
			<div
				class="project-card__media"
				id={galleryId}
				data-project-gallery={imageCount > 1 ? '' : undefined}
				data-scrollable={imageCount > 1 ? 'true' : 'false'}
				role={imageCount > 1 ? 'region' : undefined}
				aria-label={imageCount > 1
					? `${title} image gallery, ${imageCount} images. Use the up and down controls or scroll vertically.`
					: undefined}
				aria-describedby={imageCount > 1 ? galleryStatusId : undefined}
				tabindex={imageCount > 1 ? 0 : undefined}
			>
				<div class="project-card__media-track">
					{images.map((image, index) => (
						<div
							class="project-card__image-frame"
							aria-current={imageCount > 1 && index === 0 ? 'true' : undefined}
						>
							<Image
								class="project-card__image"
								src={image.src}
								alt={image.alt}
								layout="full-width"
								widths={projectImageWidths.filter((width) => width <= image.src.width)}
								sizes={getProjectImageSizes(image.src)}
								quality="high"
							/>
						</div>
					))}
				</div>
			</div>

			{imageCount > 1 && (
				<div
					class="project-card__gallery-controls"
					role="group"
					aria-label={`${title} image navigation`}
				>
					<button
						class="project-card__gallery-control"
						type="button"
						aria-label={`Show previous ${title} image`}
						aria-controls={galleryId}
						data-gallery-previous
						disabled
					>
						<ChevronUp size={18} stroke-width={1.8} aria-hidden="true" />
					</button>

					<button
						class="project-card__gallery-control"
						type="button"
						aria-label={`Show next ${title} image`}
						aria-controls={galleryId}
						data-gallery-next
					>
						<ChevronDown size={18} stroke-width={1.8} aria-hidden="true" />
					</button>

					<p
						class="project-card__sr-only"
						id={galleryStatusId}
						data-gallery-status
						aria-live="polite"
					>
						Showing image 1 of {imageCount}: {images[0]?.alt}
					</p>
				</div>
			)}
		</div>
	)}

	<div class="project-card__details">
		<div class="project-card__copy">
			<p class="project-card__label">{eyebrow}</p>
			<h3>{title}</h3>
			<p class="project-card__description">{description}</p>

			{technologies.length > 0 && (
				<ul class="project-card__stack" aria-label={`${title} technology stack`}>
					{technologies.map((technology) => {
						const icon = technologyIcons.get(technology);

						return (
							<li>
								{icon && (
									<svg
										class="project-card__stack-icon"
										viewBox="0 0 24 24"
										aria-hidden="true"
										focusable="false"
									>
										<path d={icon.path} />
									</svg>
								)}
								<span>{technology}</span>
							</li>
						);
					})}
				</ul>
			)}
		</div>

		{hasActions && (
			<div class="project-card__actions">
				{sourceConfig?.url && (
					<span>
						{sourceConfig.private ? (
							<span
								class="project-card__source project-card__source--disabled"
								role="link"
								aria-disabled="true"
								aria-label={`Private ${source.name} source repository`}
								title={`Private ${source.name} repository`}
								data-magnetic-target
							>
								<svg
									class="project-card__source-icon"
									viewBox="0 0 24 24"
									aria-hidden="true"
									focusable="false"
								>
									<path d={source.icon.path} />
								</svg>
							</span>
						) : (
							<a
								class="project-card__source"
								href={sourceConfig.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Open ${source.name} source repository in a new tab`}
								title={`${source.name} repository`}
								data-magnetic-target
							>
								<svg
									class="project-card__source-icon"
									viewBox="0 0 24 24"
									aria-hidden="true"
									focusable="false"
								>
									<path d={source.icon.path} />
								</svg>
							</a>
						)}
					</span>
				)}

				{liveUrl && (
					<span>
						<a
							class="project-card__action"
							href={liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`Open ${title} live website in a new tab`}
							title="Open live website"
							data-magnetic-target
						>
							<ArrowUpRight size={24} stroke-width={1.6} />
						</a>
					</span>
				)}
			</div>
		)}
	</div>
</article>

<style>
	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		background:
			linear-gradient(var(--glass-surface), var(--glass-surface)),
			var(--color-background);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}
	.project-card:has(.project-card__primary-link:focus-visible) {
		outline: 2px solid var(--color-text);
		outline-offset: 4px;
	}
	.project-card__primary-link {
		position: absolute;
		z-index: 1;
		inset: 0;
		border-radius: inherit;
	}
	.project-card__primary-link:focus-visible {
		outline: 0;
	}
	.project-card__media-shell {
		position: relative;
		z-index: 2;
		flex: 0 0 auto;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-block-end: 1px solid var(--glass-border);
		background: var(--glass-surface);
	}
	.project-card__media {
		width: 100%;
		height: 100%;
		overflow: hidden;
		cursor: auto;
		touch-action: pan-y;
	}
	.project-card__media[data-scrollable='true'] {
		overflow-y: auto;
		scroll-snap-type: y mandatory;
		scrollbar-width: none;
	}
	.project-card__media[data-scrollable='true']:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: -4px;
	}
	.project-card__media::-webkit-scrollbar {
		display: none;
	}
	.project-card__media[data-gallery-hinting='true'] .project-card__media-track {
		animation: project-gallery-scroll-hint 900ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.project-card__media-track {
		height: 100%;
	}
	.project-card__image-frame {
		position: relative;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		border-block-end: 2px solid var(--glass-border);
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}
	.project-card__image-frame:last-child {
		border-block-end: 0;
	}
	.project-card__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}
	@keyframes project-gallery-scroll-hint {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}

		40%,
		58% {
			transform: translate3d(0, -3rem, 0);
		}
	}
	.project-card__gallery-controls {
		position: absolute;
		z-index: 3;
		inset-block-end: 0.65rem;
		inset-inline-start: 50%;
		display: flex;
		gap: 0.4rem;
		transform: translateX(-50%);
	}
	.project-card__gallery-control {
		display: grid;
		width: 2.25rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 50%;
		background: rgba(9, 11, 12, 0.76);
		color: #ffffff;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
		transition: background-color 160ms ease, border-color 160ms ease, opacity 160ms ease;
	}
	.project-card__gallery-control:hover:not(:disabled) {
		border-color: rgba(255, 255, 255, 0.42);
		background: rgba(9, 11, 12, 0.9);
	}
	.project-card__gallery-control:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 2px;
		box-shadow: 0 0 0 4px rgba(9, 11, 12, 0.78);
	}
	.project-card__gallery-control:disabled {
		cursor: default;
		opacity: 0.32;
	}
	.project-card__details {
		display: flex;
		flex: 1;
		align-items: stretch;
		justify-content: space-between;
		flex-direction: column;
		gap: 1.5rem;
		padding: clamp(1.25rem, 4vw, 2rem);
	}
	.project-card__copy {
		display: grid;
		gap: 0.4rem;
	}
	.project-card__label {
		color: var(--color-accent-text);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}
	h3 {
		font-size: clamp(2rem, 8vw, 3.5rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.045em;
		overflow-wrap: anywhere;
		text-wrap: balance;
	}
	.project-card__description {
		max-width: 32ch;
		color: var(--color-muted);
		font-size: clamp(0.9rem, 3vw, 1.05rem);
		line-height: 1.45;
	}
	.project-card__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-block-start: 0.65rem;
	}
	.project-card__stack li {
		position: relative;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		overflow: hidden;
		padding: 0.32rem 0.55rem;
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1;
		isolation: isolate;
		transition:
			border-color 220ms ease,
			color 220ms ease,
			box-shadow 220ms ease;
	}
	.project-card__stack li::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(
			35deg,
			var(--glass-highlight-hover),
			var(--glass-glow) 55%,
			transparent 100%
		);
		clip-path: circle(0 at 0 100%);
		content: '';
		opacity: 0.55;
		pointer-events: none;
		transition: clip-path 480ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.project-card__stack li:hover {
		border-color: var(--glass-border-hover);
		color: var(--color-text);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}
	.project-card__stack li:hover::before {
		clip-path: circle(150% at 0 100%);
	}
	.project-card__stack-icon {
		width: 0.8rem;
		height: 0.8rem;
		flex: 0 0 auto;
		fill: currentColor;
	}
	.project-card__actions {
		position: relative;
		display: flex;
		align-self: flex-end;
		gap: 0.6rem;
		margin-block-start: auto;
	}
	.project-card__source,
	.project-card__action {
		display: grid;
		width: 3.25rem;
		aspect-ratio: 1;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-surface);
	}
	.project-card__source {
		position: relative;
		z-index: 2;
		color: var(--color-text);
	}
	.project-card__action {
		position: relative;
		z-index: 2;
	}
	a.project-card__source:hover,
	a.project-card__source:focus-visible,
	a.project-card__action:hover,
	a.project-card__action:focus-visible {
		border-color: var(--glass-border-hover);
	}
	a.project-card__source:focus-visible,
	a.project-card__action:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 3px;
	}
	.project-card__source--disabled {
		color: var(--color-muted);
		cursor: not-allowed;
		opacity: 0.45;
	}
	.project-card__source-icon {
		width: 1.35rem;
		height: 1.35rem;
		fill: currentColor;
	}
	@media (min-width: 75rem) {
		.project-card {
			display: grid;
			height: auto;
			aspect-ratio: 128 / 51;
			grid-template-columns: minmax(0, 17fr) minmax(0, 7fr);
		}
		.project-card__media-shell {
			border-block-end: 0;
			border-inline-end: 1px solid var(--glass-border);
		}
		.project-card__details {
			min-height: 0;
			overflow: hidden;
			padding: clamp(1.25rem, 2.5vw, 2rem);
		}
		.project-card__copy {
			min-height: 0;
			overflow-y: auto;
			overscroll-behavior: contain;
			scrollbar-width: thin;
			scrollbar-color: var(--glass-border-hover) transparent;
		}
		h3 {
			font-size: clamp(2rem, 3.2vw, 2.75rem);
		}
	}
	.project-card__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.project-card__media-track {
			animation: none;
		}
		.project-card__gallery-control {
			transition: none;
		}
		.project-card__stack li,
		.project-card__stack li::before {
			transition: none;
		}
	}
</style>
