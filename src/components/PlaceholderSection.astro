---
const { id, label } = Astro.props;
---

<section class="placeholder-section" id={id} aria-label={label}>
	<p>&lt;tmp&gt;</p>
</section>

<style>
	.placeholder-section {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		place-items: center;
		padding: var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		scroll-margin-top: 5rem;
	}

	.placeholder-section p {
		color: var(--color-muted);
		font-family: monospace;
		font-size: clamp(1rem, 3vw, 1.25rem);
	}
</style>
