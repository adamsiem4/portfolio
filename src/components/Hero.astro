---
import { ChevronDown } from '@lucide/astro';
import KineticText from './KineticText.astro';

const eyebrowText = 'Hi, my name is';
const eyebrowCharacters = Array.from(eyebrowText);
---

<section class="hero" id="home" aria-labelledby="hero-title" tabindex="-1">
	<div class="hero__content">
		<p class="hero__eyebrow">
			<span class="hero__eyebrow-accessible">{eyebrowText}</span>
			<span class="hero__eyebrow-letters" aria-hidden="true" data-eyebrow-repel>
				{eyebrowCharacters.map((character) => (
					<span class="hero__eyebrow-letter" data-eyebrow-letter>
						{character === ' ' ? '\u00a0' : character}
					</span>
				))}
			</span>
		</p>
		<h1 class="hero__title" id="hero-title">
			<KineticText text="Adam Salicki" />
		</h1>
	</div>

	<span class="hero__scroll-magnetic" data-magnetic data-magnetic-max="8">
		<a
			class="hero__scroll-link"
			href="#about"
			aria-label="Scroll to About"
			data-magnetic-target
		>
			<span class="hero__scroll-icon" aria-hidden="true">
				<ChevronDown size={28} stroke-width={1.6} />
			</span>
		</a>
	</span>
</section>


<style>
	.hero {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		place-items: center;
		padding: var(--page-gutter);
	}

	.hero__content {
		width: min(100%, 72rem);
		min-width: 0;
	}

	.hero:focus {
		outline: none;
	}

	.hero__eyebrow {
		position: relative;
		width: fit-content;
		margin-bottom: 0.1rem;
		color: var(--color-accent-text);
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0.1em;
		white-space: nowrap;
	}

	.hero__eyebrow-letters {
		display: inline-flex;
	}

	.hero__eyebrow-letter {
		display: inline-block;
		will-change: transform;
	}

	.hero__eyebrow-accessible {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.hero__scroll-magnetic {
		position: absolute;
		inset-inline-start: 50%;
		bottom: max(1.25rem, env(safe-area-inset-bottom));
		display: block;
		width: 3rem;
		height: 3rem;
		transform: translateX(-50%);
	}

	.hero__scroll-link {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-surface);
		color: var(--color-text);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		backdrop-filter: blur(12px);
		transition: border-color 180ms ease, background-color 180ms ease;
		will-change: transform;
	}

	.hero__scroll-link:hover {
		border-color: var(--glass-border-hover);
		background: var(--glass-surface-hover);
	}

	.hero__scroll-link:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 4px;
	}

	.hero__scroll-icon {
		display: block;
		animation: scroll-nudge 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
	}

	.hero__scroll-link:hover .hero__scroll-icon {
		animation-duration: 1s;
	}

	@keyframes scroll-nudge {
		0%,
		100% {
			opacity: 0.45;
			transform: translateY(-0.2rem);
		}

		50% {
			opacity: 1;
			transform: translateY(0.25rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__eyebrow-letter {
			will-change: auto;
		}

		.hero__scroll-icon {
			animation: none;
		}
	}
</style>
