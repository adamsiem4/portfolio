---
import KineticText from './KineticText.astro';
---

<section class="hero" id="home">
	<div class="hero__content">
		<KineticText text="Adam Salicki" />
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		place-items: center;
		padding: var(--page-gutter);
	}

	.hero__content {
		width: min(100%, 72rem);
		min-width: 0;
	}
</style>
