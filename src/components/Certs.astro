---
import { Image } from 'astro:assets';
import githubFoundationsBadge from '../assets/github-foundations.png';
import ScrambleHeading from './ScrambleHeading.astro';
---

<section class="certs" id="certs" aria-labelledby="certs-title">
	<div class="certs__inner">
		<header>
			<ScrambleHeading id="certs-title" text="Certs" />
		</header>

		<article class="cert-card">
			<div class="cert-card__badge" aria-hidden="true" data-cert-badge-tilt>
				<Image
					class="cert-card__badge-icon"
					data-cert-badge-tilt-target
					src={githubFoundationsBadge}
					alt=""
					width={224}
					height={224}
					quality="high"
				/>
			</div>

			<div class="cert-card__details">
				<p class="cert-card__label">Certification</p>
				<h3>GitHub Foundations</h3>
				<p class="cert-card__summary">&lt;tmp&gt;</p>

				<dl class="cert-card__meta">
					<div>
						<dt>Issuer</dt>
						<dd>&lt;tmp&gt;</dd>
					</div>
					<div>
						<dt>Issued</dt>
						<dd>&lt;tmp&gt;</dd>
					</div>
					<div>
						<dt>Credential</dt>
						<dd>&lt;tmp&gt;</dd>
					</div>
				</dl>
			</div>
		</article>
	</div>
</section>

<script>
	const tiltArea = document.querySelector<HTMLElement>('[data-cert-badge-tilt]');
	const tiltTarget = tiltArea?.querySelector<HTMLElement>('[data-cert-badge-tilt-target]');
	const canTilt = window.matchMedia(
		'(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
	);

	if (tiltArea && tiltTarget) {
		let animationFrame: number | null = null;
		let rotateX = 0;
		let rotateY = 0;

		const reset = () => {
			if (animationFrame !== null) cancelAnimationFrame(animationFrame);
			animationFrame = null;
			tiltTarget.style.removeProperty('--cert-tilt-x');
			tiltTarget.style.removeProperty('--cert-tilt-y');
		};

		const render = () => {
			tiltTarget.style.setProperty('--cert-tilt-x', `${rotateX.toFixed(2)}deg`);
			tiltTarget.style.setProperty('--cert-tilt-y', `${rotateY.toFixed(2)}deg`);
			animationFrame = null;
		};

		tiltArea.addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse' || !canTilt.matches) {
				reset();
				return;
			}

			const bounds = tiltArea.getBoundingClientRect();
			if (!bounds.width || !bounds.height) return;

			rotateX = ((event.clientY - bounds.top) / bounds.height - 0.5) * -20;
			rotateY = ((event.clientX - bounds.left) / bounds.width - 0.5) * 20;
			if (animationFrame === null) animationFrame = requestAnimationFrame(render);
		});

		tiltArea.addEventListener('pointerleave', reset);
		tiltArea.addEventListener('pointercancel', reset);
		canTilt.addEventListener?.('change', reset);
		window.addEventListener('blur', reset);
	}
</script>

<style>
	.certs {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		align-items: start;
		padding: clamp(5rem, 10vw, 7rem) var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		scroll-margin-top: 5rem;
	}

	.certs__inner {
		display: grid;
		width: min(100%, 72rem);
		margin-inline: auto;
		gap: clamp(2.5rem, 8vw, 5rem);
	}

	.cert-card {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}

	.cert-card__badge {
		display: grid;
		place-items: center;
	}

	.cert-card__badge-icon {
		display: block;
		width: min(76%, 14rem);
		height: auto;
		filter: drop-shadow(0 1.25rem 2rem var(--glass-glow));
	}

	.cert-card__details {
		display: grid;
		align-content: center;
		gap: 0.4rem;
	}

	.cert-card__label,
	.cert-card__meta dt {
		color: var(--color-accent-text);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h3 {
		font-size: clamp(2rem, 8vw, 3.5rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.045em;
		overflow-wrap: anywhere;
		text-wrap: balance;
	}

	.cert-card__summary,
	.cert-card__meta dd {
		color: var(--color-muted);
		line-height: 1.5;
	}

	.cert-card__summary {
		margin-block-start: 0.6rem;
	}

	.cert-card__meta {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
		gap: 0.75rem 1rem;
		margin-block-start: 1rem;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--glass-border);
	}

	.cert-card__meta div {
		display: grid;
		gap: 0.2rem;
	}

	.cert-card__meta dt {
		font-size: 0.58rem;
		letter-spacing: 0.13em;
	}

	.cert-card__meta dd {
		font-size: 0.8rem;
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.cert-card__badge {
			perspective: 44rem;
		}

		.cert-card__badge-icon {
			transform:
				translate3d(0, 0, 0)
				rotateX(var(--cert-tilt-x, 0deg))
				rotateY(var(--cert-tilt-y, 0deg))
				scale(1);
			transform-origin: center;
			transform-style: preserve-3d;
			transition:
				transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
				filter 220ms ease;
		}

		.cert-card__badge:hover .cert-card__badge-icon {
			transform:
				translate3d(0, 0, 0)
				rotateX(var(--cert-tilt-x, 0deg))
				rotateY(var(--cert-tilt-y, 0deg))
				scale(1.035);
			filter: drop-shadow(0 1.6rem 2.5rem var(--glass-glow));
			will-change: transform;
		}
	}

	@media (min-width: 48rem) {
		.certs {
			align-items: center;
		}

		.cert-card {
			grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.15fr);
		}
	}
</style>
