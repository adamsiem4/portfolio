---
import ScrambleHeading from './ScrambleHeading.astro';
---

<section class="certs" id="certs" aria-labelledby="certs-title">
	<div class="certs__inner">
		<ScrambleHeading id="certs-title" text="Certs" />
		<div class="certs__card" aria-hidden="true"></div>
	</div>
</section>

<style>
	.certs {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		align-items: center;
		padding: clamp(5rem, 10vw, 7rem) var(--page-gutter);
		border-block-start: 1px solid var(--glass-border);
		scroll-margin-top: 5rem;
	}

	.certs__inner {
		display: grid;
		width: min(100%, 72rem);
		margin-inline: auto;
		gap: clamp(2.5rem, 8vw, 5rem);
	}

	.certs__card {
		min-height: clamp(20rem, 72vw, 28rem);
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		background:
			linear-gradient(145deg, var(--glass-gradient-start), transparent 62%),
			var(--glass-surface);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}

	@media (min-width: 48rem) {
		.certs__inner {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
			align-items: start;
		}

		.certs__card {
			min-height: clamp(22rem, 38vw, 28rem);
		}
	}
</style>
