---
import { Mail } from '@lucide/astro';
import { siGithub, siLinkedin } from 'simple-icons';
import { siteConfig } from '../config/site.js';

const emailHref = `mailto:${siteConfig.contactEmail}`;

const socialLinks = [
	{
		label: 'GitHub',
		href: siteConfig.githubUrl,
		brandPath: siGithub.path,
	},
	{
		label: 'LinkedIn',
		href: siteConfig.linkedinUrl,
		brandPath: siLinkedin.path,
	},
];
---

<section class="contact" id="contact" aria-labelledby="contact-title">
	<div class="contact__inner">
		<p class="contact__eyebrow">Contact information</p>
		<h2 id="contact-title">Get in touch</h2>
		<hr class="contact__divider" />

		<div class="contact__information">
			<div class="contact__methods">
				<span class="contact__magnetic" data-magnetic data-magnetic-max="10">
					<a
						class="contact__email"
						href={emailHref}
						aria-label={`Email ${siteConfig.contactEmail}`}
						data-magnetic-target
					>
						<span class="contact__email-icon" aria-hidden="true">
							<Mail size={24} stroke-width={1.8} />
						</span>
						<span class="contact__email-address">{siteConfig.contactEmail}</span>
					</a>
				</span>

				<div class="contact__socials" aria-label="Social profiles">
					{socialLinks.map(({ label, href, brandPath }) => (
						<span class="contact__magnetic" data-magnetic data-magnetic-max="8">
							<a
								class="contact__social-link"
								href={href}
								aria-label={label}
								title={label}
								target="_blank"
								rel="noopener noreferrer"
								data-magnetic-target
							>
								<svg
									class="contact__brand-icon"
									viewBox="0 0 24 24"
									aria-hidden="true"
									focusable="false"
								>
									<path d={brandPath} />
								</svg>
							</a>
						</span>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		place-items: center;
		padding: clamp(5rem, 14vw, 9rem) var(--page-gutter);
		background: var(--color-accent);
		color: #ffffff;
		scroll-margin-top: 0;
	}

	.contact__inner {
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		text-align: left;
	}

	.contact__eyebrow {
		margin-bottom: 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h2 {
		font-size: clamp(4rem, 17vw, 10rem);
		font-weight: 800;
		line-height: 0.88;
		letter-spacing: -0.05em;
	}

	.contact__divider {
		width: 100%;
		margin-block: clamp(2rem, 2vw, 2rem) clamp(2rem, 2vw, 2rem);
		border: 0;
		border-block-start: 1px solid rgba(255, 255, 255, 0.28);
	}

	.contact__information {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
	}

	.contact__methods {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.contact__email,
	.contact__social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.32);
		background: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
		transform: translate3d(0, 0, 0);
		will-change: transform;
		transition: background-color 180ms ease;
	}

	.contact__magnetic {
		display: inline-flex;
		max-width: 100%;
	}

	.contact__email {
		width: fit-content;
		max-width: 100%;
		min-height: 3.5rem;
		gap: clamp(0.35rem, 1.5vw, 0.55rem);
		padding: 0.8rem clamp(0.5rem, 2.5vw, 1rem);
		border-radius: 999px;
	}

	.contact__email-icon {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
	}

	.contact__email-address {
		min-width: 0;
		font-size: clamp(0.85rem, 4vw, 1.125rem);
		font-weight: 700;
		overflow-wrap: anywhere;
		cursor: text;
		user-select: text;
	}

	.contact__socials {
		display: flex;
		gap: 0.75rem;
	}

	.contact__social-link {
		width: 3.5rem;
		aspect-ratio: 1;
		border-radius: 50%;
	}

	.contact__magnetic:hover .contact__email,
	.contact__magnetic:hover .contact__social-link {
		background: rgba(255, 255, 255, 0.14);
	}

	.contact__brand-icon {
		width: 1.5rem;
		height: 1.5rem;
		fill: currentColor;
	}

	.contact__email:focus-visible,
	.contact__social-link:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
	}

	@media (min-width: 48rem) {
		.contact__methods {
			width: auto;
			flex-direction: row;
			align-items: center;
		}
	}
</style>
