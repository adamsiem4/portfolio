---
import { ArrowLeft } from '@lucide/astro';
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.js';
import { useTranslations } from '../i18n/ui.js';

const pl = useTranslations('pl');
const en = useTranslations('en');
const title = `${pl('notFound.title')} | ${siteConfig.authorName}`;
const titleAlternate = `${en('notFound.title')} | ${siteConfig.authorName}`;
---

<Layout
	title={title}
	titleAlternate={titleAlternate}
	description={pl('notFound.description')}
	canonical="/404"
	robots={siteConfig.notFoundRobots}
	showPageLoader={false}
	localeAuto
>
	<Navbar localeAuto />
	<main class="not-found" id="home" tabindex="-1" aria-labelledby="not-found-title">
		<div class="not-found__content">
			<p class="not-found__code" aria-hidden="true">404</p>
			<h1 id="not-found-title">
				<span data-locale-copy="pl">{pl('notFound.heading')}</span>
				<span data-locale-copy="en">{en('notFound.heading')}</span>
			</h1>
			<p class="not-found__description">
				<span data-locale-copy="pl">{pl('notFound.body')}</span>
				<span data-locale-copy="en">{en('notFound.body')}</span>
			</p>
			<span
				class="not-found__home-magnetic"
				data-magnetic
				data-magnetic-max="6"
				data-magnetic-strength="0.16"
			>
				<a class="not-found__home-link" href="/" data-magnetic-target>
					<ArrowLeft size={20} stroke-width={1.8} aria-hidden="true" />
					<span data-locale-copy="pl">{pl('notFound.back')}</span>
					<span data-locale-copy="en">{en('notFound.back')}</span>
				</a>
			</span>
		</div>
	</main>
</Layout>

<style>
	.not-found {
		min-height: 100vh;
		min-height: 100dvh;
		display: grid;
		overflow: hidden;
		padding: clamp(7rem, 18vh, 10rem) var(--page-gutter) clamp(3.5rem, 10vh, 6rem);
		place-items: center;
	}

	.not-found:focus {
		outline: 0;
	}

	.not-found__code {
		color: var(--color-text);
		font-family: "Open Sans", sans-serif;
		font-size: clamp(10rem, 33vw, 26rem);
		font-variant-numeric: tabular-nums;
		font-weight: 800;
		letter-spacing: -0.055em;
		line-height: 0.72;
		white-space: nowrap;
	}

	.not-found__content {
		display: grid;
		min-width: 0;
		width: min(100%, 64rem);
		justify-items: center;
		gap: 1rem;
		text-align: center;
	}

	.not-found h1 {
		max-width: 12ch;
		font-size: clamp(2.5rem, 8vw, 5rem);
		font-weight: 800;
		letter-spacing: -0.055em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.not-found__description {
		max-width: 36rem;
		color: var(--color-muted);
		font-size: clamp(0.95rem, 2.7vw, 1.05rem);
		line-height: 1.7;
	}

	.not-found__home-magnetic {
		display: inline-flex;
		width: fit-content;
		margin-block-start: 0.5rem;
	}

	.not-found__home-link {
		display: inline-flex;
		width: fit-content;
		min-height: 3rem;
		align-items: center;
		gap: 0.55rem;
		padding: 0.7rem 1rem;
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		background: var(--glass-surface);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		font-family: "Open Sans", sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		will-change: transform;
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.not-found__home-link:hover {
		border-color: var(--glass-border-hover);
		background: var(--glass-surface-hover);
	}

	.not-found__home-link:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 4px;
	}

	@media (min-width: 48rem) {
		.not-found__code {
			margin-block-end: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.not-found__home-link {
			transition: none;
		}
	}
</style>
