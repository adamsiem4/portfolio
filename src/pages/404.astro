---
import { ArrowLeft } from '@lucide/astro';
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.js';

const title = `Page not found | ${siteConfig.authorName}`;
const description = 'The requested page could not be found. Return to Adam Salicki’s portfolio.';
---

<Layout
	title={title}
	description={description}
	canonical="/404"
	robots="noindex, follow"
	showPageLoader={false}
>
	<Navbar />
	<main class="not-found" id="home" tabindex="-1" aria-labelledby="not-found-title">
		<div class="not-found__panel">
			<p class="not-found__code" aria-hidden="true">404</p>

			<div class="not-found__content">
				<p class="not-found__eyebrow">Route not found</p>
				<h1 id="not-found-title">You’ve reached a dead end.</h1>
				<p class="not-found__description">
					The page may have moved, or the address may be incorrect. The portfolio is still
					waiting at the starting point.
				</p>

				<span
					class="not-found__home-magnetic"
					data-magnetic
					data-magnetic-max="6"
					data-magnetic-strength="0.16"
				>
					<a class="not-found__home-link" href="/" data-magnetic-target>
						<ArrowLeft size={20} stroke-width={1.8} aria-hidden="true" />
						Back to portfolio
					</a>
				</span>
			</div>
		</div>
	</main>
</Layout>

<style>
	.not-found {
		position: relative;
		min-height: 100vh;
		min-height: 100dvh;
		display: grid;
		overflow: hidden;
		padding: clamp(7rem, 18vh, 10rem) var(--page-gutter) clamp(3.5rem, 10vh, 6rem);
		place-items: center;
		isolation: isolate;
	}

	.not-found:focus {
		outline: 0;
	}

	.not-found::before {
		position: absolute;
		z-index: -1;
		width: min(72vw, 42rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-accent) 18%, transparent);
		content: '';
		filter: blur(8rem);
		opacity: 0.6;
		pointer-events: none;
		transform: translate3d(-42%, 24%, 0);
	}

	.not-found__panel {
		display: grid;
		width: min(100%, 72rem);
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		background:
			linear-gradient(145deg, var(--glass-gradient-start), transparent 58%),
			var(--glass-surface);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			0 2rem 6rem var(--glass-shadow);
		isolation: isolate;
	}

	.not-found__code {
		display: grid;
		min-height: 13rem;
		place-items: center;
		overflow: hidden;
		padding: 1.25rem;
		border-block-end: 1px solid var(--glass-border);
		color: color-mix(in srgb, var(--color-text) 7%, transparent);
		font-family: "Open Sans", sans-serif;
		font-size: clamp(8rem, 40vw, 10rem);
		font-variant-numeric: tabular-nums;
		font-weight: 800;
		letter-spacing: -0.055em;
		line-height: 0.8;
		white-space: nowrap;
	}

	.not-found__content {
		display: grid;
		align-content: center;
		gap: 1rem;
		padding: clamp(1.5rem, 7vw, 3.5rem);
	}

	.not-found__eyebrow {
		color: var(--color-accent-text);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.not-found h1 {
		max-width: 10ch;
		font-size: clamp(2.75rem, 12vw, 5.75rem);
		font-weight: 800;
		letter-spacing: -0.055em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.not-found__description {
		max-width: 39rem;
		color: var(--color-muted);
		font-size: clamp(0.95rem, 2.7vw, 1.05rem);
		line-height: 1.7;
	}

	.not-found__home-magnetic {
		display: inline-flex;
		width: fit-content;
		margin-block-start: 0.5rem;
	}

	.not-found__home-link {
		display: inline-flex;
		width: fit-content;
		min-height: 3rem;
		align-items: center;
		gap: 0.55rem;
		padding: 0.7rem 1rem;
		border: 1px solid var(--glass-border);
		border-radius: 999px;
		background: var(--glass-surface);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		font-family: "Open Sans", sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		will-change: transform;
		transition: border-color 180ms ease, background-color 180ms ease;
	}

	.not-found__home-link:hover {
		border-color: var(--glass-border-hover);
		background: var(--glass-surface-hover);
	}

	.not-found__home-link:focus-visible {
		outline: 2px solid var(--color-accent-text);
		outline-offset: 4px;
	}

	@media (min-width: 48rem) {
		.not-found__panel {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		}

		.not-found__code {
			min-height: 30rem;
			padding: 2rem;
			border-block-end: 0;
			border-inline-end: 1px solid var(--glass-border);
			font-size: clamp(9rem, 17vw, 15rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.not-found__home-link {
			transition: none;
		}
	}
</style>
