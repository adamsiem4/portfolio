import Hero from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import PlaceholderSection from '../components/PlaceholderSection.astro';
---

<Layout title="Adam Salicki Portfolio">
	<Navbar />
	<main>
		<Hero />
		<PlaceholderSection id="about" label="About" />
		<PlaceholderSection id="portfolio" label="Portfolio" />
		<Contact />
	</main>
	<Footer />
</Layout>
